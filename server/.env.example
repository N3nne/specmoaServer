NODE_ENV=development
PORT=3000
# Set a private random value of at least 32 characters. Development fallback rotates access-token keys on restart.
JWT_SECRET=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/specmoa_DB
DB_SCHEMA=public
DB_SYNC=true
DB_SSL=false
# Development defaults to demo; production defaults to disabled. No automatic fallback or seeding.
JOBS_SOURCE=demo
# Optional AI prototype. Never send actual user profiles to the unpaid Gemini API.
# HTTP demo is disabled unless explicitly enabled, and always disabled in production.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DEMO_ENABLED=false
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
EXTERNAL_CERT_API_URL=
EXTERNAL_CERT_API_KEY=
QNET_SERVICE_KEY=
QNET_NATIONAL_QUALIFICATION_LIST_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryListNationalQualifcationSVC/getList
QNET_CERTIFICATION_DETAIL_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryInformationTradeNTQSVC/getList
QNET_EXAM_SCHEDULE_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryTestInformationNTQSVC/getJMList
QNET_EXAM_ELIGIBILITY_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryExamQualItemSVC/getList
QNET_ACQUISITION_STAT_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryQualRelaPtcondSVC/getArtlList
QNET_MAJOR_STAT_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryQualRelaPtcondSVC/getMajorList
QNET_PASS_RATE_STAT_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryEmqualPassSVC/getList
QNET_ROUND_PASS_RATE_STAT_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryQualPassRateSVC/getList
